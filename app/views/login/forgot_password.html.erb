<% content_for :head do %>
  <%= stylesheet_link_tag "login" %>
<% end %>

<div class="login-container">
  <svg class="login-curve" viewBox="0 0 100 100" preserveAspectRatio="none">
    <path fill="#f6f3ec" d="M 0 0 L 40 0 C 50 30, 50 70, 40 100 L 0 100 Z"/>
  </svg>

  <section class="login-panel-form">
    <div class="login-form-inner">
      <p class="login-eyebrow">Account Recovery</p>
      <h1 class="login-title">Reset Password</h1>
      <p class="login-sub" id="form-subtitle">Enter your email to receive an OTP.</p>

      <!-- Step 1: Request OTP -->
      <form id="step-1-form">
        <div class="login-field">
          <label for="identifier">Email</label>
          <input id="identifier" type="email" placeholder="you@domain.com" required>
        </div>
        <button type="submit" class="login-submit" id="btn-step-1">Send OTP</button>
        <div class="login-row-between" style="margin-top: 15px; justify-content: center;">
          <a href="/login" class="login-remember" style="color: var(--primary);">Back to login</a>
        </div>
      </form>

      <!-- Step 2: Verify OTP -->
      <form id="step-2-form" style="display:none;">
        <div class="login-field">
          <label for="otp">One-Time Password</label>
          <input id="otp" type="text" placeholder="123456" required>
        </div>
        <button type="submit" class="login-submit" id="btn-step-2">Verify OTP</button>
      </form>

      <!-- Step 3: New Password -->
      <form id="step-3-form" style="display:none;">
        <div class="login-field">
          <label for="new_password">New Password</label>
          <div class="login-field-password">
            <input id="new_password" type="password" placeholder="••••••••••" required>
          </div>
        </div>
        <button type="submit" class="login-submit" id="btn-step-3">Update Password</button>
      </form>

      <div id="reset-error" class="login-error" style="display:none; margin-top: 20px;"></div>
      <div id="reset-success" class="login-error" style="display:none; margin-top: 20px; color: #155724; background-color: #d4edda; border-color: #c3e6cb;"></div>
    </div>
  </section>

  <div class="login-mobile-curve">
    <svg viewBox="0 0 100 20" preserveAspectRatio="none">
      <path fill="#f6f3ec" d="M0,20 L0,16 C30,4 70,4 100,16 L100,20 Z"/>
    </svg>
  </div>

  <section class="login-panel-visual">
    <div class="login-glow"></div>
    <div class="login-plate-wrap">
      <div class="login-plate">
        <%= image_tag "logo.png", alt: "Crib logo", class: "login-logo-image" %>
      </div>
      <h2 class="login-wordmark">Crib</h2>
      <p class="login-railtag">Ruby · on Rails</p>
      <div class="login-plate-rule"></div>
      <p class="login-plate-copy">Securely reset your password to regain access.</p>
    </div>
  </section>
</div>

<script>
  let userEmail = '';
  let validOtp = '';
  const errorDiv = document.getElementById('reset-error');
  const successDiv = document.getElementById('reset-success');
  
  function showError(msg) {
    errorDiv.style.display = 'block';
    errorDiv.textContent = msg;
    successDiv.style.display = 'none';
  }
  
  function showSuccess(msg) {
    successDiv.style.display = 'block';
    successDiv.textContent = msg;
    errorDiv.style.display = 'none';
  }
  
  function clearMessages() {
    errorDiv.style.display = 'none';
    successDiv.style.display = 'none';
  }

  // Step 1: Send OTP
  document.getElementById('step-1-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    clearMessages();
    userEmail = document.getElementById('identifier').value;
    const btn = document.getElementById('btn-step-1');
    btn.textContent = 'Sending...';
    btn.disabled = true;

    try {
      const response = await fetch('/password_resets', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ identifier: userEmail })
      });
      const data = await response.json();
      if (data.success) {
        showSuccess(data.message);
        document.getElementById('step-1-form').style.display = 'none';
        document.getElementById('step-2-form').style.display = 'block';
        document.getElementById('form-subtitle').textContent = 'Enter the OTP sent to your email.';
      } else {
        showError(data.message);
      }
    } catch (err) {
      showError('Failed to send request.');
    } finally {
      btn.textContent = 'Send OTP';
      btn.disabled = false;
    }
  });

  // Step 2: Verify OTP
  document.getElementById('step-2-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    clearMessages();
    validOtp = document.getElementById('otp').value;
    const btn = document.getElementById('btn-step-2');
    btn.textContent = 'Verifying...';
    btn.disabled = true;

    try {
      const response = await fetch('/password_resets/verify', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ identifier: userEmail, otp: validOtp })
      });
      const data = await response.json();
      if (data.success) {
        showSuccess(data.message);
        document.getElementById('step-2-form').style.display = 'none';
        document.getElementById('step-3-form').style.display = 'block';
        document.getElementById('form-subtitle').textContent = 'Create a new password.';
      } else {
        showError(data.message);
      }
    } catch (err) {
      showError('Failed to verify OTP.');
    } finally {
      btn.textContent = 'Verify OTP';
      btn.disabled = false;
    }
  });

  // Step 3: Update Password
  document.getElementById('step-3-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    clearMessages();
    const newPassword = document.getElementById('new_password').value;
    const btn = document.getElementById('btn-step-3');
    btn.textContent = 'Updating...';
    btn.disabled = true;

    try {
      const response = await fetch('/password_resets/update_password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ identifier: userEmail, otp: validOtp, new_password: newPassword })
      });
      const data = await response.json();
      if (data.success) {
        showSuccess(data.message);
        if (window.showNotification) {
          window.showNotification(data.message, 'success', 2000);
        }
        setTimeout(() => { window.location.href = data.redirect; }, 1500);
      } else {
        showError(data.message);
        btn.textContent = 'Update Password';
        btn.disabled = false;
      }
    } catch (err) {
      showError('Failed to update password.');
      btn.textContent = 'Update Password';
      btn.disabled = false;
    }
  });
</script>
