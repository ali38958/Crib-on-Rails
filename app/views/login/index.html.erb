<% content_for :head do %>
  <%= stylesheet_link_tag "login" %>
<% end %>

<div class="login-container">

  <svg class="login-curve" viewBox="0 0 100 100" preserveAspectRatio="none">
    <path fill="#f6f3ec" d="M 0 0 L 40 0 C 50 30, 50 70, 40 100 L 0 100 Z"/>
  </svg>

  <section class="login-panel-form">
    <div class="login-form-inner">
      <p class="login-eyebrow">Welcome back</p>
      <h1 class="login-title">Sign in to Crib</h1>
      <p class="login-sub">Access your inventory dashboard.</p>

      <form id="login-form">
        <div class="login-field">
          <label for="identifier">Email or ID</label>
          <input id="identifier" type="text" placeholder="you@domain.com or ID" autocomplete="email">
        </div>
        <div class="login-field">
          <label for="password">Password</label>
          <div class="login-field-password">
            <input id="password" type="password" placeholder="••••••••••" autocomplete="current-password">
            <button type="button" class="login-eye-toggle" id="eyeToggle" aria-label="Show password">
              <svg class="eye-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1.5 12S5 5 12 5s10.5 7 10.5 7-3.5 7-10.5 7S1.5 12 1.5 12Z"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
              <svg class="eye-closed" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 3l18 18"/>
                <path d="M10.6 5.2A10.8 10.8 0 0 1 12 5c7 0 10.5 7 10.5 7a13.4 13.4 0 0 1-3.1 4.1M6.6 6.6C3.4 8.6 1.5 12 1.5 12S5 19 12 19a10.6 10.6 0 0 0 5.4-1.5"/>
                <path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/>
              </svg>
            </button>
          </div>
        </div>

        <div class="login-row-between">
          <label class="login-remember">
            <input type="checkbox">
            Stay signed in
          </label>
          <a href="/forgot_password" class="login-remember" style="color: var(--primary);">Forgot password?</a>
        </div>

        <button type="submit" class="login-submit">Sign in</button>
        <div id="login-error" class="login-error" style="display:none;"></div>
      </form>
    </div>
  </section>

  <div class="login-mobile-curve">
    <svg viewBox="0 0 100 20" preserveAspectRatio="none">
      <path fill="#f6f3ec" d="M0,20 L0,16 C30,4 70,4 100,16 L100,20 Z"/>
    </svg>
  </div>

  <section class="login-panel-visual">
    <div class="login-glow"></div>
    <div class="login-plate-wrap">
      <div class="login-plate">
        <%= image_tag "logo.png", alt: "Crib logo", class: "login-logo-image" %>
      </div>
      <h2 class="login-wordmark">Crib</h2>
      <p class="login-railtag">Ruby · on Rails</p>
      <div class="login-plate-rule"></div>
      <p class="login-plate-copy">Every crate, shelf, and unit — tracked, counted, in its place.</p>
      <p class="login-addr">Warehouse Access — Authorized Only</p>
    </div>
  </section>

</div>

<script>
  const eyeToggle = document.getElementById('eyeToggle');
  const passwordInput = document.getElementById('password');
  eyeToggle.addEventListener('click', () => {
    const isVisible = passwordInput.type === 'text';
    passwordInput.type = isVisible ? 'password' : 'text';
    eyeToggle.classList.toggle('is-visible', !isVisible);
    eyeToggle.setAttribute('aria-label', isVisible ? 'Show password' : 'Hide password');
  });

  document.getElementById('login-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const identifier = document.getElementById('identifier').value;
    const password = document.getElementById('password').value;
    const errorDiv = document.getElementById('login-error');
    
    try {
      const response = await fetch('/login', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ identifier, password })
      });
      
      const data = await response.json();

      if (data.success && data.redirect) {
        // Show success notification, then redirect after 1 second
        window.showNotification('Welcome back! Redirecting...', 'success', 1000);
        setTimeout(() => {
          window.location.href = data.redirect;
        }, 1000);
      } else {
        // Show error notification
        const message = data.message || 'Login failed';
        window.showNotification(message, 'error', 2000);
        errorDiv.style.display = 'block';
        errorDiv.textContent = message;
      }
      
    } catch (error) {
      errorDiv.style.display = 'block';
      errorDiv.textContent = 'Login failed';
    }
  });
</script>