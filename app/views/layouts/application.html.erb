<!DOCTYPE html>
<html>
<head>
  <title>Crib on Rails</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= javascript_importmap_tags %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Manrope:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <%= stylesheet_link_tag "admin/users", "data-turbo-track": "reload" if current_role == 'Admin' %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "variables", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "layout", "data-turbo-track": "reload" %>
  <%= yield :head %>
</head>
<body>
  <% if cookies[:auth_token] && controller_name != 'login' %>
    <!-- Logged in - show header + sidebar -->
    <header class="header">
      <div class="header-left">
        <button class="menu-btn" id="menuBtn" aria-label="Toggle navigation">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
        <div class="logo-mark">
          <svg viewBox="0 0 66 66" fill="none">
            <rect x="16" y="24" width="34" height="24" rx="2" stroke="var(--brass)" stroke-width="2"/>
            <path d="M16 32H50" stroke="var(--brass)" stroke-width="2"/>
            <path d="M24 24V19a9 9 0 0 1 18 0v5" stroke="var(--brass)" stroke-width="2"/>
            <circle cx="33" cy="40" r="1.6" fill="var(--brass)"/>
          </svg>
        </div>
        <div class="logo-text">
          <span class="word">Crib</span>
          <span class="tag">Ruby · on Rails</span>
        </div>
      </div>

      <div class="header-right">
        <div class="user-chip">
          <div class="avatar"><%= @current_user&.name&.first&.upcase || 'U' %></div>
          <div class="user-info">
            <span class="user-name"><%= @current_user&.name || 'User' %></span>
            <span class="user-role"><%= current_role || 'User' %></span>
          </div>
        </div>
        <%= link_to logout_path, method: :delete, class: "logout-btn" do %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          <span class="logout-label">Logout</span>
        <% end %>
      </div>
    </header>

    <div class="body-wrap">
      <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

      <aside class="sidebar" id="sidebar">
        <div class="sidebar-head">
          <button class="collapse-btn" id="collapseBtn" aria-label="Collapse sidebar">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
        </div>
        <nav class="nav-list">
          <% case current_role %>
          <% when 'Admin' %>
            <%= link_to admin_path, class: "nav-item #{'active' if request.path == admin_path}" do %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>
              <span class="nav-label">Dashboard</span>
            <% end %>
            <%= link_to admin_users_path, class: "nav-item #{'active' if request.path.include?('users')}" do %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              <span class="nav-label">Users</span>
            <% end %>

          <% when 'StockManager' %>
            <%= link_to stock_manager_path, class: "nav-item #{'active' if request.path == stock_manager_path}" do %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>
              <span class="nav-label">Dashboard</span>
            <% end %>
            <%= link_to stock_manager_suppliers_path, class: "nav-item #{'active' if request.path.include?('suppliers')}" do %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              <span class="nav-label">Suppliers</span>
            <% end %>
            <%= link_to stock_manager_products_path, class: "nav-item #{'active' if request.path.include?('products')}" do %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
              <span class="nav-label">Products</span>
          <% end %>

          <% when 'OrderReceiver' %>
            <%= link_to order_receiver_path, class: "nav-item active" do %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>
              <span class="nav-label">Dashboard</span>
            <% end %>
          <% end %>
        </nav>
      </aside>

      <main class="main">
        <%= yield %>
      </main>
    </div>
  <% else %>
    <!-- Not logged in -->
    <%= yield %>
  <% end %>

<script>
  const STORAGE_KEY = 'sidebarCollapsed';
  let sidebarEventsBound = false;

  function getSidebar() {
    return document.getElementById('sidebar');
  }

  function getMenuButton() {
    return document.getElementById('menuBtn');
  }

  function getCollapseButton() {
    return document.getElementById('collapseBtn');
  }

  function getBackdrop() {
    return document.getElementById('sidebarBackdrop');
  }

  function isMobile() {
    return window.innerWidth <= 900;
  }

  function getSavedSidebarState() {
    return localStorage.getItem(STORAGE_KEY) === 'true';
  }

  function saveSidebarState(isCollapsed) {
    localStorage.setItem(STORAGE_KEY, String(isCollapsed));
  }

  function applySidebarState() {
    const sidebar = getSidebar();
    if (!sidebar) return;

    if (isMobile()) {
      sidebar.classList.remove('collapsed');
      sidebar.setAttribute('aria-collapsed', 'false');
      return;
    }

    const shouldCollapse = getSavedSidebarState();
    sidebar.classList.toggle('collapsed', shouldCollapse);
    sidebar.setAttribute('aria-collapsed', String(shouldCollapse));

    const collapseBtn = getCollapseButton();
    if (collapseBtn) {
      collapseBtn.setAttribute('aria-expanded', String(!shouldCollapse));
    }
  }

  function toggleSidebar() {
    const sidebar = getSidebar();
    const collapseBtn = getCollapseButton();
    if (!sidebar) return;

    if (isMobile()) {
      const backdrop = getBackdrop();
      sidebar.classList.toggle('mobile-open');
      if (backdrop) {
        backdrop.classList.toggle('visible');
      }
      return;
    }

    const nextCollapsed = !sidebar.classList.contains('collapsed');
    sidebar.classList.toggle('collapsed', nextCollapsed);
    sidebar.setAttribute('aria-collapsed', String(nextCollapsed));
    saveSidebarState(nextCollapsed);

    if (collapseBtn) {
      collapseBtn.setAttribute('aria-expanded', String(!nextCollapsed));
    }
  }

  function handleSidebarClick(event) {
    const collapseBtn = event.target.closest('#collapseBtn');
    if (collapseBtn) {
      event.preventDefault();
      toggleSidebar();
      return;
    }

    const menuBtn = event.target.closest('#menuBtn');
    if (menuBtn && isMobile()) {
      const sidebar = getSidebar();
      const backdrop = getBackdrop();
      sidebar?.classList.toggle('mobile-open');
      backdrop?.classList.toggle('visible');
      return;
    }

    const backdrop = getBackdrop();
    if (backdrop && event.target === backdrop) {
      const sidebar = getSidebar();
      sidebar?.classList.remove('mobile-open');
      backdrop.classList.remove('visible');
    }
  }

  function initializeSidebar() {
    const sidebar = getSidebar();
    if (!sidebar) return;

    if (!sidebarEventsBound) {
      document.addEventListener('click', handleSidebarClick);
      window.addEventListener('resize', applySidebarState);
      document.addEventListener('turbo:load', applySidebarState);
      document.addEventListener('turbo:render', applySidebarState);
      sidebarEventsBound = true;
    }

    const collapseBtn = getCollapseButton();
    if (collapseBtn) {
      collapseBtn.setAttribute('aria-expanded', String(!sidebar.classList.contains('collapsed')));
    }

    applySidebarState();
  }

  document.addEventListener('DOMContentLoaded', initializeSidebar);
  document.addEventListener('turbo:load', initializeSidebar);
  document.addEventListener('turbo:render', initializeSidebar);
</script>
  
<div id="notificationContainer" style="position: fixed; top: 80px; right: 20px; z-index: 99999; display: flex; flex-direction: column; gap: 10px; max-width: 380px;"></div>

<script>
  window.showNotification = function(message, type = 'success', duration = 2000) {
    const container = document.getElementById('notificationContainer');
    if (!container) {
      alert(message);
      return;
    }

    const normalizedType = String(type || 'success').toLowerCase();
    const palette = {
      success: { border: '#5c7d4c', background: 'rgba(107,143,90,0.14)', color: '#5c7d4c', icon: '✓' },
      error: { border: '#b25c4a', background: 'rgba(178,92,74,0.14)', color: '#b25c4a', icon: '✕' },
      fail: { border: '#b25c4a', background: 'rgba(178,92,74,0.14)', color: '#b25c4a', icon: '✕' },
      warning: { border: '#c08a2b', background: 'rgba(192,138,43,0.14)', color: '#c08a2b', icon: '!' },
      info: { border: '#4a6d97', background: 'rgba(74,109,151,0.14)', color: '#4a6d97', icon: 'i' }
    };
    const theme = palette[normalizedType] || palette.info;

    const notification = document.createElement('div');
    notification.style.cssText = `
      background: #f6f3ec;
      border-radius: 12px;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
      border-left: 4px solid ${theme.border};
      overflow: hidden;
      animation: slideIn 0.3s ease;
      min-width: 280px;
    `;
    notification.innerHTML = `
      <div style="display: flex; align-items: center; padding: 14px 18px; gap: 12px;">
        <span style="display: flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 50%; font-size: 16px; font-weight: 700; flex-shrink: 0; background: ${theme.background}; color: ${theme.color};">
          ${theme.icon}
        </span>
        <span style="flex: 1; font-size: 0.9rem; font-weight: 500; color: #1b1d24;">${message}</span>
        <button onclick="this.parentElement.parentElement.remove()" style="background: none; border: none; font-size: 20px; color: #8b8d97; cursor: pointer; padding: 0 4px;">×</button>
      </div>
    `;

    container.appendChild(notification);

    if (!document.getElementById('notification-style')) {
      const style = document.createElement('style');
      style.id = 'notification-style';
      style.textContent = `
        @keyframes slideIn {
          from { transform: translateX(100%); opacity: 0; }
          to { transform: translateX(0); opacity: 1; }
        }
      `;
      document.head.appendChild(style);
    }

    setTimeout(() => {
      if (notification.parentElement) {
        notification.style.transition = 'all 0.3s ease';
        notification.style.opacity = '0';
        notification.style.transform = 'translateX(100%)';
        setTimeout(() => {
          if (notification.parentElement) {
            notification.remove();
          }
        }, 300);
      }
    }, duration);
  };
</script>
</body>
</html>