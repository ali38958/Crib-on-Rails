<% content_for :head do %>
  <%= stylesheet_link_tag "stock_manager/purchases" %>
<% end %>

<div class="page-header">
  <div>
    <p class="page-eyebrow">Procurement</p>
    <h1 class="page-title">Purchases</h1>
    <p class="page-sub">View purchase history.</p>
  </div>
  <div class="page-actions">
    <%= link_to "New Purchase", new_stock_manager_purchase_path, class: "btn btn-primary" %>
  </div>
</div>

<div class="panel-card">
  <table>
    <thead>
      <tr>
        <th>Purchase ID</th>
        <th>Product</th>
        <th>Supplier</th>
        <th>Quantity</th>
        <th>Total Price</th>
        <th>Date</th>
      </tr>
    </thead>
    <tbody>
      <% @purchases.each do |purchase| %>
        <tr>
          <td>#<%= purchase.id %></td>
          <td><%= purchase.product&.name || 'N/A' %></td>
          <td><%= purchase.supplier&.name || 'N/A' %></td>
          <td><%= purchase.quantity %></td>
          <td>$<%= purchase.total_price %></td>
          <td><%= purchase.created_at.strftime("%b %d, %Y") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>