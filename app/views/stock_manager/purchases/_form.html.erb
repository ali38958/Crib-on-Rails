<%= stylesheet_link_tag "stock_manager/suppliers" %>

<div class="modal-overlay" id="purchaseModal">
  <div class="modal-content" style="max-width: 550px; max-height: 80vh;">
    <div class="modal-header">
      <h2><%= action == 'new' ? "New Purchase" : "Edit Purchase" %></h2>
      <button type="button" class="modal-close" id="purchaseModalCloseBtn" data-close-stock-manager-modal="purchaseModal">&times;</button>
    </div>
    
    <div class="modal-body">
      <% if @purchase.errors.any? %>
        <div class="error-messages">
          <ul>
            <% @purchase.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
      
      <form id="purchaseForm" method="post" action="<%= action == 'new' ? stock_manager_purchases_path : stock_manager_purchase_path(@purchase) %>" data-turbo="false">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        <input type="hidden" name="_method" value="<%= action == 'new' ? 'post' : 'patch' %>">
        
        <div class="form-group">
          <label for="purchase_supplier_id">Supplier *</label>
          <div style="display: flex; gap: 8px; align-items: center;">
            <select name="purchase[supplier_id]" id="purchase_supplier_id" required style="flex:1; padding: 10px 14px; font-family: 'Manrope', sans-serif; font-size: 0.95rem; color: var(--ink); background: var(--paper-2); border: 1px solid transparent; border-radius: var(--radius); outline: none; max-height: 150px; overflow-y: auto;">
              <option value="">Select Supplier</option>
              <% Supplier.all.each do |supplier| %>
                <option value="<%= supplier.id %>" <%= 'selected' if @supplier_id.to_i == supplier.id || @purchase.supplier_id == supplier.id %>>
                  <%= supplier.name %>
                </option>
              <% end %>
            </select>
            <button type="button" class="btn btn-sm btn-secondary" onclick="openQuickSupplierModal()">+</button>
          </div>
        </div>
        
        <div class="form-group">
          <label for="purchase_product_id">Product *</label>
          <select name="purchase[product_id]" id="purchase_product_id" required style="width:100%; padding: 10px 14px; font-family: 'Manrope', sans-serif; font-size: 0.95rem; color: var(--ink); background: var(--paper-2); border: 1px solid transparent; border-radius: var(--radius); outline: none; max-height: 120px; overflow-y: auto;">
            <option value="">Select Product</option>
            <% Product.all.each do |product| %>
              <option value="<%= product.id %>" <%= 'selected' if @purchase.product_id == product.id %>>
                <%= product.name %> (Stock: <%= product.quantity %>)
              </option>
            <% end %>
          </select>
        </div>
        
        <div class="form-group">
          <label for="purchase_quantity">Quantity *</label>
          <input type="number" name="purchase[quantity]" id="purchase_quantity" min="1" required value="<%= @purchase.quantity %>" class="supplier-input">
        </div>
        
        <div class="form-group">
          <label for="purchase_total_price">Total Price *</label>
          <input type="number" name="purchase[total_price]" id="purchase_total_price" step="0.01" min="0" required value="<%= @purchase.total_price %>" class="supplier-input">
        </div>
        
        <div class="form-group">
          <label for="purchase_status">Status</label>
          <select name="purchase[status]" id="purchase_status" style="width:100%; padding: 10px 14px; font-family: 'Manrope', sans-serif; font-size: 0.95rem; color: var(--ink); background: var(--paper-2); border: 1px solid transparent; border-radius: var(--radius); outline: none;">
            <option value="pending" <%= 'selected' if @purchase.status == 'pending' %>>Pending</option>
            <option value="received" <%= 'selected' if @purchase.status == 'received' %>>Received</option>
            <option value="cancelled" <%= 'selected' if @purchase.status == 'cancelled' %>>Cancelled</option>
          </select>
        </div>
        
        <div class="form-group">
          <label for="purchase_notes">Notes</label>
          <input type="text" name="purchase[notes]" id="purchase_notes" value="<%= @purchase.notes %>" class="supplier-input">
        </div>
        
        <div class="form-actions">
          <button type="submit" class="btn btn-primary" id="purchaseSubmitBtn"><%= action == 'new' ? "Create Purchase" : "Update Purchase" %></button>
          <button type="button" class="btn btn-secondary" id="purchaseModalCancelBtn" data-close-stock-manager-modal="purchaseModal">Cancel</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  function openQuickSupplierModal() {
    const modal = document.getElementById('purchaseModal');
    if (modal) modal.remove();
    document.body.style.overflow = 'auto';
    setTimeout(() => {
      window.openSupplierModal();
    }, 300);
  }
</script>