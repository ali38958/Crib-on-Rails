<% content_for :head do %>
  <%= stylesheet_link_tag "order_receiver/customers" %>
<% end %>

<div class="page-header">
  <div>
    <p class="page-eyebrow">Customers</p>
    <h1 class="page-title">Manage Customers</h1>
    <p class="page-sub">View and manage all customers.</p>
  </div>
  <div class="page-actions">
    <button onclick="openCustomerModal()" class="btn btn-primary">+ Add Customer</button>
  </div>
</div>

<!-- Filters -->
<div class="filters-bar">
  <div class="filters-left">
    <div class="filter-group">
      <input type="text" id="searchInput" placeholder="Search customers..." value="<%= params[:search] %>" class="filter-input">
    </div>
    
    <div class="filter-group">
      <select id="perPageSelect" class="filter-select">
        <option value="10" <%= 'selected' if params[:per_page].to_i == 10 || params[:per_page].blank? %>>10 per page</option>
        <option value="25" <%= 'selected' if params[:per_page].to_i == 25 %>>25 per page</option>
        <option value="50" <%= 'selected' if params[:per_page].to_i == 50 %>>50 per page</option>
      </select>
    </div>
    
    <% if params[:search].present? %>
      <button id="clearFiltersBtn" class="btn btn-sm btn-secondary">Clear Filters</button>
    <% end %>
  </div>
  
  <div class="filters-right">
    <span class="results-count"><span id="totalCount"><%= @total_count %></span> customers found</span>
  </div>
</div>

<!-- Customers Table -->
<div id="customersTable">
  <%= render 'table' %>
</div>

<!-- Modal Container -->
<div id="customerModalContainer"></div>

<script>
  // Modal close functions
  function closeCustomerModal(modalId) {
    const modal = document.getElementById(modalId);
    if (modal) {
      modal.remove();
    }
    if (!document.querySelector('.modal-overlay')) {
      document.body.style.overflow = 'auto';
    }
  }

  document.addEventListener('click', function(e) {
    const closeTrigger = e.target.closest('[data-close-customer-modal]');
    if (closeTrigger) {
      e.preventDefault();
      closeCustomerModal(closeTrigger.getAttribute('data-close-customer-modal'));
      return;
    }

    const overlay = e.target.closest('.modal-overlay');
    if (overlay && e.target === overlay) {
      closeCustomerModal(overlay.id);
    }
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      const activeModal = document.querySelector('.modal-overlay');
      if (activeModal) {
        closeCustomerModal(activeModal.id);
      }
    }
  });

  // Customer functions
  function openCustomerModal(id = null) {
    const container = document.getElementById('customerModalContainer');
    container.innerHTML = '';
    let url = id ? '/order_receiver/customers/' + id + '/edit' : '/order_receiver/customers/new';
    fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
      .then(response => response.text())
      .then(html => {
        container.innerHTML = html;
        document.body.style.overflow = 'hidden';
      });
  }

  function editCustomer(id) { openCustomerModal(id); }

  // Search and filter functions
  document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('searchInput');
    const perPageSelect = document.getElementById('perPageSelect');
    const clearFiltersBtn = document.getElementById('clearFiltersBtn');
    const tableContainer = document.getElementById('customersTable');
    
    // Focus search input if there's a value
    if (searchInput && searchInput.value) {
      searchInput.focus();
      searchInput.setSelectionRange(searchInput.value.length, searchInput.value.length);
    }
    
    function fetchCustomers() {
      const params = new URLSearchParams();
      if (searchInput && searchInput.value) params.set('search', searchInput.value);
      if (perPageSelect) params.set('per_page', perPageSelect.value);
      params.set('page', 1);
      
      const url = window.location.pathname + '?' + params.toString();
      
      window.history.pushState({}, '', url);
      
      fetch(url, {
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
      })
      .then(response => response.text())
      .then(html => {
        const parser = new DOMParser();
        const doc = parser.parseFromString(html, 'text/html');
        const newTable = doc.getElementById('customersTable');
        if (newTable) {
          tableContainer.innerHTML = newTable.innerHTML;
        }
        const newCount = doc.getElementById('totalCount');
        if (newCount) {
          document.getElementById('totalCount').textContent = newCount.textContent;
        }
        if (searchInput) {
          searchInput.focus();
          searchInput.setSelectionRange(searchInput.value.length, searchInput.value.length);
        }
      })
      .catch(error => console.error('Error:', error));
    }
    
    let searchTimeout;
    if (searchInput) {
      searchInput.addEventListener('input', function() {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(fetchCustomers, 400);
      });
    }
    
    if (perPageSelect) {
      perPageSelect.addEventListener('change', fetchCustomers);
    }
    
    if (clearFiltersBtn) {
      clearFiltersBtn.addEventListener('click', function() {
        searchInput.value = '';
        fetchCustomers();
      });
    }
    
    document.addEventListener('click', function(e) {
      const paginationLink = e.target.closest('.pagination a');
      if (paginationLink) {
        e.preventDefault();
        const url = paginationLink.href;
        window.history.pushState({}, '', url);
        
        fetch(url, {
          headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(response => response.text())
        .then(html => {
          const parser = new DOMParser();
          const doc = parser.parseFromString(html, 'text/html');
          const newTable = doc.getElementById('customersTable');
          if (newTable) {
            tableContainer.innerHTML = newTable.innerHTML;
          }
          const newCount = doc.getElementById('totalCount');
          if (newCount) {
            document.getElementById('totalCount').textContent = newCount.textContent;
          }
          if (searchInput) {
            searchInput.focus();
            searchInput.setSelectionRange(searchInput.value.length, searchInput.value.length);
          }
        })
        .catch(error => console.error('Error:', error));
      }
    });
  });
</script>