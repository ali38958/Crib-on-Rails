<% content_for :head do %>
  <%= stylesheet_link_tag "admin/users" %>
<% end %>

<h1 class="page-title">Add New <%= @role %></h1>

<%= form_with model: @user, url: admin_users_path(role: @role), method: :post, class: "user-form" do |f| %>
  <div class="form-group">
    <%= f.label :id %>
    <%= f.text_field :id, required: true %>
  </div>
  
  <div class="form-group">
    <%= f.label :name %>
    <%= f.text_field :name, required: true %>
  </div>
  
  <div class="form-group">
    <%= f.label :phone %>
    <%= f.text_field :phone %>
  </div>
  
  <div class="form-group">
    <%= f.label :email %>
    <%= f.email_field :email %>
  </div>
  
  <div class="form-group">
    <%= f.label :password %>
    <%= f.password_field :password, required: true %>
  </div>
  
  <div class="form-group">
    <%= f.label :password_confirmation %>
    <%= f.password_field :password_confirmation, required: true %>
  </div>
  
  <div class="form-group">
    <%= f.label :status %>
    <%= f.select :status, [['Active', 'active'], ['Inactive', 'inactive']] %>
  </div>
  
  <div class="form-actions">
    <%= f.submit "Create #{@role}", class: "btn btn-primary" %>
    <%= link_to "Cancel", admin_users_path, class: "btn btn-secondary" %>
  </div>
<% end %>